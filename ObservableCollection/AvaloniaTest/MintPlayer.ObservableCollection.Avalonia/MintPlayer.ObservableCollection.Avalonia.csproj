<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<!--
		No Avalonia.Diagnostics reference on purpose. That package has no 12.x release (11.3.22 is
		the newest on nuget.org), and Avalonia 12 did not fold DevTools into another package - the
		Avalonia.Diagnostics namespace in the core 12.x assemblies is only the low-level debug
		surface (AvaloniaObjectExtensions.GetDiagnostic, IAvaloniaObjectDebug), not DevTools.

		Pinning 11.3.22 here would restore, because NuGet unifies Avalonia up to 12.1.2, and then
		fail at runtime the first time somebody added AttachDevTools(): 11.x-compiled DevTools
		against the 12.x runtime. Nothing in this sample calls AttachDevTools(), so the reference
		was only a trap. Add it back once Avalonia.Diagnostics ships a 12.x.
		-->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\MintPlayer.ObservableCollection.Extensions\MintPlayer.ObservableCollection.Extensions.csproj" />
	</ItemGroup>
</Project>
