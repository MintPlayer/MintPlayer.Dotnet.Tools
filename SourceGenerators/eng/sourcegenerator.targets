<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	This file only applies to projects within this solution
	-->
	
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DevelopmentDependency>true</DevelopmentDependency>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<Import Project="$(MSBuildThisFileDirectory)roslyn.props" />

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis" Version="$(MicrosoftCodeAnalysisVersion)" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisAnalyzersVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Tools\MintPlayer.SourceGenerators.Tools.csproj" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPathsCommon</GetTargetPathDependsOn>
	</PropertyGroup>

	<!--
	The analyzer payload is collected inside a TARGET, not in a static ItemGroup.

	It used to be `<None Include="...\bin\$(Configuration)\netstandard2.0\*.dll" Pack="true" />`.
	A glob in a static ItemGroup is expanded at project EVALUATION time — before any
	ProjectReference has been built — so on a clean tree it matched nothing and the package
	shipped without the assembly the generator's base class lives in. The result restores
	cleanly, reports nothing, and the generator never runs in the consumer.

	It looked like it worked because a full `dotnet build` had already populated those bin
	folders. `dotnet pack` on its own, in either configuration, produced a broken package.
	(A Configuration == 'Release' condition on the same items made Debug fail even after a
	build; that was a second bug on top of this one, and is also gone.)

	TargetsForTfmSpecificContentInPackage is NuGet's documented hook for exactly this: it runs
	during pack, after Build, so the referenced projects' output exists by the time the items
	are collected. PackagingTests pins both the layout and Debug/Release parity.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddGeneratorAnalyzerAssets</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<!--
	The Roslyn 4.9 flavour, built out of this same project file with $(RoslynVersion) overridden.
	/Directory.Build.props redirects its obj\ and bin\ so it cannot collide with the default
	(Roslyn 5.0) build sitting in the plain bin\$(Configuration)\.

	Guarded against re-entry: the inner build inherits nothing of this because it runs Build, not
	Pack, but the condition makes that explicit rather than incidental.
	-->
	<Target Name="BuildRoslyn49Flavour" Condition="'$(RoslynVersion)' == '' or '$(RoslynVersion)' == 'roslyn5.0'">
		<!--
		A separate `dotnet build` PROCESS, not the MSBuild task.

		The flavour has its own BaseIntermediateOutputPath, so it needs its own restore: the outer
		`dotnet build`/`dotnet pack` restored the DEFAULT obj\ only, and nothing else ever writes
		obj\roslyn4.9\project.assets.json. Without it the inner build fails NETSDK1004 on every
		clean checkout and every CI run - it only appears to work on a tree where someone has
		already built this flavour by hand.

		The MSBuild task cannot do it. Restore and Build there share one project-evaluation cache
		keyed on (project, global properties); both calls have the same key, so Build reuses the
		evaluation from before Restore wrote the assets file and fails with a wall of CS0518 /
		CS0012 "Predefined type 'System.Object' is not defined" - the shape of a project evaluated
		with no references at all. Splitting Targets="Restore" and Targets="Build" into two tasks
		does not help, because the cache is what is stale, not the ordering.

		A child process gets a fresh evaluation and an implicit restore, which is exactly what
		`msbuild -restore` does internally. Recursion is not a concern: the inner build carries
		RoslynVersion=roslyn4.9, so this target's own condition is false there.
		-->
		<Exec Command="dotnet build &quot;$(MSBuildProjectFullPath)&quot; -c $(Configuration) -p:RoslynVersion=roslyn4.9 --nologo -v quiet" />
	</Target>

	<Target Name="AddGeneratorAnalyzerAssets" DependsOnTargets="BuildRoslyn49Flavour">
		<PropertyGroup>
			<!--
			Where each flavour's output lands. Keep these two in step with the PackagePath values
			below and with /Directory.Build.props - the folder name under analyzers/dotnet/ is
			Roslyn's probing convention (host loads the highest roslyn<N.N> folder <= its own
			compiler version), so a mismatch here hands a consumer bits built against a compiler
			they do not have.
			-->
			<_Roslyn50Out>$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0</_Roslyn50Out>
			<_Roslyn49Out>$(MSBuildProjectDirectory)\bin\roslyn4.9\$(Configuration)\netstandard2.0</_Roslyn49Out>
			<_ToolsDir>$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Tools\bin</_ToolsDir>
		</PropertyGroup>

		<ItemGroup>
			<_GeneratorAssembly50 Include="$(_Roslyn50Out)\$(AssemblyName).dll" />
			<_GeneratorAssembly49 Include="$(_Roslyn49Out)\$(AssemblyName).dll" />

			<_GeneratorToolsAssets50 Include="$(_ToolsDir)\$(Configuration)\netstandard2.0\*.dll" />
			<_GeneratorToolsAssets49 Include="$(_ToolsDir)\roslyn4.9\$(Configuration)\netstandard2.0\*.dll" />

			<!--
			The generator's OWN attributes assembly, from this project's own output directory.

			One rule, uniformly: a generator ships the attributes package it triggers on. Anything
			else a particular generator needs in analyzers/dotnet/cs is that feature's business —
			the [AutoValueComparer] dependency, for instance, is added by
			eng/valuecomparergenerator.targets, which only the projects that actually use it import.

			Attributes are plain netstandard2.0 with no Roslyn reference, so one copy serves both
			flavours and it is taken from the default build.
			-->
			<_GeneratorAttributeAssets Include="$(_Roslyn50Out)\$(AssemblyName).Attributes.dll" />
		</ItemGroup>

		<!--
		Hard failures, not warnings. Each of these produces a package that installs happily and
		does nothing, which is the worst outcome available for a source generator: the consumer
		has no error to search for.

		Note the two different tests. A LITERAL Include creates the item whether or not the file
		exists, so '@(x)' == '' never fires for one — it has to be Exists() on the item's path.
		A GLOB contributes nothing when it matches nothing, so there '@(x)' == '' is the correct
		and only workable test. Getting this backwards produces a guard that silently never
		fires, which is worse than no guard because it reads as protection.

		Both flavours are checked. A missing roslyn4.9 build is the quiet failure this whole
		dual-build exists to prevent: pack would simply ship one folder and every Roslyn 4.x
		consumer would fall through to nothing.
		-->
		<Error Condition="!Exists('%(_GeneratorAssembly50.FullPath)')"
		       Text="The generator assembly was not found at bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll. Packing would produce a package with no analyzer in it." />
		<Error Condition="!Exists('%(_GeneratorAssembly49.FullPath)')"
		       Text="The Roslyn 4.9 generator assembly was not found at bin\roslyn4.9\$(Configuration)\netstandard2.0\$(AssemblyName).dll. Packing would ship nothing for Roslyn 4.x hosts." />
		<Error Condition="'@(_GeneratorToolsAssets50)' == ''"
		       Text="MintPlayer.SourceGenerators.Tools was not found in bin\$(Configuration)\netstandard2.0. Packing would produce a generator that cannot resolve its base class and silently never runs." />
		<Error Condition="'@(_GeneratorToolsAssets49)' == ''"
		       Text="MintPlayer.SourceGenerators.Tools was not found in bin\roslyn4.9\$(Configuration)\netstandard2.0. Packing would ship a Roslyn 4.9 generator whose base class assembly is missing." />
		<Error Condition="!Exists('%(_GeneratorAttributeAssets.FullPath)')"
		       Text="$(AssemblyName).Attributes.dll was not found in bin\$(Configuration)\netstandard2.0. Packing would produce a generator whose own attributes Roslyn cannot resolve." />

		<ItemGroup>
			<!-- The attributes live one level up, shared by both Roslyn versions. -->
			<TfmSpecificPackageFile Include="@(_GeneratorAttributeAssets)" PackagePath="$(RoslynSharedPackagePath)" />

			<!-- Roslyn 4.9 — compiled against Microsoft.CodeAnalysis.CSharp 4.14.0 -->
			<TfmSpecificPackageFile Include="@(_GeneratorAssembly49)" PackagePath="$(Roslyn49PackagePath)" />
			<TfmSpecificPackageFile Include="@(_GeneratorToolsAssets49)" PackagePath="$(Roslyn49PackagePath)" />

			<!-- Roslyn 5.0 — compiled against Microsoft.CodeAnalysis.CSharp 5.9.0 -->
			<TfmSpecificPackageFile Include="@(_GeneratorAssembly50)" PackagePath="$(Roslyn50PackagePath)" />
			<TfmSpecificPackageFile Include="@(_GeneratorToolsAssets50)" PackagePath="$(Roslyn50PackagePath)" />
		</ItemGroup>
	</Target>

	<Target Name="GetDependencyTargetPathsCommon">
		<!-- Include dependency DLLs and put them in the correct package path -->
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Tools\bin\$(Configuration)\netstandard2.0\MintPlayer.SourceGenerators.Tools.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

	<Import Project="./filenesting.targets"/>
</Project>