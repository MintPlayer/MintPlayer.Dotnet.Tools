<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	This file only applies to projects within this solution
	-->
	
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>15</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<DevelopmentDependency>true</DevelopmentDependency>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<!--
	ONE Roslyn version, named honestly.

	This used to be a <Choose> on $(RoslynVersion) with a 'roslyn4.0' branch and an <Otherwise>.
	$(RoslynVersion) was declared empty and nothing ever set it, so <Otherwise> always won: the
	'roslyn4.0' branch was dead, both branches referenced the SAME package versions, and the only
	difference between them was a set of ROSLYN_4_* DefineConstants that no source file in this
	repository ever tested. It was a dual build in appearance only.

	5.9.0 is the floor, and it is chosen rather than inherited: it was raised from 5.0.0 to the latest
	stable Roslyn on nuget.org, knowingly giving up .NET SDKs before 10.0.4xx. Measured Roslyn by SDK:

	    .NET 10.0.112   Roslyn 5.0.0     <- the oldest SDK that can build net10.0
	    .NET 10.0.401   Roslyn 5.9.0
	    .NET 11 rc.1    Roslyn 5.11.0

	Every SDK capable of building net10.0 or net11.0 ships Roslyn 5.x, so Roslyn 4.x support is dead
	weight for this repository now that net8.0/net9.0 are gone — there is no SDK that both builds our
	TFMs and runs a 4.x compiler. That is why this is ONE build rather than a 4.x/5.x dual build.

	History: the generators were once pinned to 5.3.0 while advertising roslyn4.0/roslyn4.9, which told
	a 5.0.0 host "this is for you", loaded a 5.3.0-built assembly and failed with CS8032. The floor was
	then lowered to 5.0.0 to reach .NET 10.0.112, and later raised to 5.9.0 by choice. Whatever the
	floor, the rule is the same: the analyzer folder must name the version the generator was BUILT
	against, so a host below it finds no matching folder and skips the generator instead of crashing.
	That includes the Assertions package, which ships its analyzers itself rather than through this file.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<PropertyGroup>
		<!--
		The single source of truth for the analyzer folder name. Roslyn probes
		analyzers/dotnet/roslyn<N.N>/cs and picks the highest folder whose version is <= its own, so
		this name IS the minimum supported Roslyn version. Five shipped build/*.props files repeat
		it; they must move together with this.
		-->
		<RoslynPackagePath>analyzers/dotnet/roslyn5.9/cs</RoslynPackagePath>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Tools\MintPlayer.SourceGenerators.Tools.csproj" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPathsCommon</GetTargetPathDependsOn>
	</PropertyGroup>

	<!--
	The analyzer payload is collected inside a TARGET, not in a static ItemGroup.

	It used to be `<None Include="...\bin\$(Configuration)\netstandard2.0\*.dll" Pack="true" />`.
	A glob in a static ItemGroup is expanded at project EVALUATION time — before any
	ProjectReference has been built — so on a clean tree it matched nothing and the package
	shipped without the assembly the generator's base class lives in. The result restores
	cleanly, reports nothing, and the generator never runs in the consumer.

	It looked like it worked because a full `dotnet build` had already populated those bin
	folders. `dotnet pack` on its own, in either configuration, produced a broken package.
	(A Configuration == 'Release' condition on the same items made Debug fail even after a
	build; that was a second bug on top of this one, and is also gone.)

	TargetsForTfmSpecificContentInPackage is NuGet's documented hook for exactly this: it runs
	during pack, after Build, so the referenced projects' output exists by the time the items
	are collected. PackagingTests pins both the layout and Debug/Release parity.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddGeneratorAnalyzerAssets</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="AddGeneratorAnalyzerAssets">
		<ItemGroup>
			<_GeneratorAssembly Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" />
			<_GeneratorToolsAssets Include="$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Tools\bin\$(Configuration)\netstandard2.0\*.dll" />

			<!--
			The generator's OWN attributes assembly, from this project's own output directory.

			One rule, uniformly: a generator ships the attributes package it triggers on. Anything
			else a particular generator needs in analyzers/dotnet/cs is that feature's business —
			the [GenerateEquality] dependency, for instance, is added by
			eng/valuecomparergenerator.targets, which only the projects that actually use it import.
			-->
			<_GeneratorAttributeAssets Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\$(AssemblyName).Attributes.dll" />
		</ItemGroup>

		<!--
		Hard failures, not warnings. Each of these produces a package that installs happily and
		does nothing, which is the worst outcome available for a source generator: the consumer
		has no error to search for.

		Note the two different tests. A LITERAL Include creates the item whether or not the file
		exists, so '@(x)' == '' never fires for one — it has to be Exists() on the item's path.
		A GLOB contributes nothing when it matches nothing, so there '@(x)' == '' is the correct
		and only workable test. Getting this backwards produces a guard that silently never
		fires, which is worse than no guard because it reads as protection.
		-->
		<Error Condition="!Exists('%(_GeneratorAssembly.FullPath)')"
		       Text="The generator assembly was not found at bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll. Packing would produce a package with no analyzer in it." />
		<Error Condition="'@(_GeneratorToolsAssets)' == ''"
		       Text="MintPlayer.SourceGenerators.Tools was not found in bin\$(Configuration)\netstandard2.0. Packing would produce a generator that cannot resolve its base class and silently never runs." />
		<Error Condition="!Exists('%(_GeneratorAttributeAssets.FullPath)')"
		       Text="$(AssemblyName).Attributes.dll was not found in bin\$(Configuration)\netstandard2.0. Packing would produce a generator whose own attributes Roslyn cannot resolve." />

		<ItemGroup>
			<!-- The attributes live one level up, version-independent: Roslyn resolves them while
			     LOADING the generator, whichever versioned folder it picked. -->
			<TfmSpecificPackageFile Include="@(_GeneratorAttributeAssets)" PackagePath="analyzers/dotnet/cs" />

			<!-- One folder, named for the Roslyn these are actually compiled against. -->
			<TfmSpecificPackageFile Include="@(_GeneratorAssembly)" PackagePath="$(RoslynPackagePath)" />
			<TfmSpecificPackageFile Include="@(_GeneratorToolsAssets)" PackagePath="$(RoslynPackagePath)" />
		</ItemGroup>
	</Target>

	<Target Name="GetDependencyTargetPathsCommon">
		<!-- Include dependency DLLs and put them in the correct package path -->
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Tools\bin\$(Configuration)\netstandard2.0\MintPlayer.SourceGenerators.Tools.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

	<Import Project="./filenesting.targets"/>
</Project>