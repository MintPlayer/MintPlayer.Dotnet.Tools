<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	This file only applies to projects within this solution
	-->

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" GeneratePathProperty="true" />
		<ProjectReference Include="$(MSBuildThisFileDirectory)\..\ValueComparers\MintPlayer.ValueComparers.NewtonsoftJson\MintPlayer.ValueComparers.NewtonsoftJson.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPathsNewtonsoftJson</GetTargetPathDependsOn>
	</PropertyGroup>

	<!--
	Collected in a TARGET, not a static ItemGroup. The comparer assembly comes from another
	project's output, and a static Include is resolved at evaluation time — before that project
	has been built — so on a clean tree it matched nothing and the package shipped without it.
	It looked fine only because a previous full build had left the file there.

	The Newtonsoft.Json include is from the restored package folder, which is populated before
	evaluation, so it has never had that problem — but it lives here too, so both halves of this
	feature's payload stay in one place.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddNewtonsoftJsonComparers</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="AddNewtonsoftJsonComparers">
		<ItemGroup>
			<_NewtonsoftJsonAssets Include="$(PkgNewtonsoft_Json)\lib\netstandard2.0\*.dll" />
			<!-- From the CONSUMING project's own output: the ProjectReference above copies it there. -->
			<_NewtonsoftJsonAssets Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\MintPlayer.ValueComparers.NewtonsoftJson.dll" />
		</ItemGroup>

		<Error Condition="!Exists('%(_NewtonsoftJsonAssets.FullPath)')"
		       Text="%(_NewtonsoftJsonAssets.Filename)%(_NewtonsoftJsonAssets.Extension) was not found. This generator registers the Newtonsoft.Json value comparers, so packing without it produces a generator that fails to load." />

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_NewtonsoftJsonAssets)" PackagePath="analyzers/dotnet/roslyn4.0/cs" />
			<TfmSpecificPackageFile Include="@(_NewtonsoftJsonAssets)" PackagePath="analyzers/dotnet/roslyn4.9/cs" />
		</ItemGroup>
	</Target>

	<Target Name="GetDependencyTargetPathsNewtonsoftJson">
		<!-- Include dependency DLLs and put them in the correct package path -->
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(PkgNewtonsoft_Json)\lib\netstandard2.0\Newtonsoft.Json.dll" IncludeRuntimeDependency="false" />
			<TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)\..\ValueComparers\MintPlayer.ValueComparers.NewtonsoftJson\bin\$(Configuration)\netstandard2.0\MintPlayer.ValueComparers.NewtonsoftJson.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>
</Project>