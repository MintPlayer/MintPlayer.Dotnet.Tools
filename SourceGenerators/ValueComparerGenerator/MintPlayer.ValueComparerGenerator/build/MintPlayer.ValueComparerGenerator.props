<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	This file does the following:
		- Only runs when the package is installed as a PackageReference, not in this solution
		- Puts the built DLL and its dependencies in the correct package path for Roslyn analyzers
	-->

	<ItemGroup Condition="'$(IsRoslynComponent)' == 'true'">
		<!-- Put the assets for this project in the correct package path -->

		<!-- Roslyn 5.0 — see eng/sourcegenerator.targets for why this is the minimum -->
		<None Include="$(PkgMintPlayer_ValueComparerGenerator_Attributes)\lib\netstandard2.0\*.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs" Visible="true" />
	</ItemGroup>
</Project>