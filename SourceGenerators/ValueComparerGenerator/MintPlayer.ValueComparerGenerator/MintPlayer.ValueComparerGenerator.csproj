<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPathsValueComparerGenerator</GetTargetPathDependsOn>
	</PropertyGroup>

	<Target Name="GetDependencyTargetPathsValueComparerGenerator">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)\..\MintPlayer.ValueComparerGenerator.Attributes\bin\$(Configuration)\netstandard2.0\MintPlayer.ValueComparerGenerator.Attributes.dll" IncludeRuntimeDependency="true" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<Version>10.20.2</Version>
		<Authors>Pieterjan De Clippel</Authors>
		<Company>MintPlayer</Company>
		<Description>This package contains a source generator that generates value-comparers for you</Description>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools/SourceGenerators/MintPlayer.SourceGenerators</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageId>MintPlayer.ValueComparerGenerator</PackageId>
		<PackageTags>SourceGenerators,ValueComparerGenerator</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

    <!--
    The attributes assembly is packed by eng/sourcegenerator.targets, which puts it in
    analyzers/dotnet/cs rather than under a roslyn-version path — attribute assemblies are shared
    by both Roslyn versions. It used to be listed again here, Release-only and resolved before the
    referenced project was built: the same file arriving twice in Release and not at all from a
    clean Debug pack.
    -->

    <ItemGroup>
        <None Include="build\MintPlayer.ValueComparerGenerator.props" Pack="true" PackagePath="build\MintPlayer.ValueComparerGenerator.props" />
        <None Include="build\MintPlayer.ValueComparerGenerator.targets" Pack="true" PackagePath="build\MintPlayer.ValueComparerGenerator.targets" />
    </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.ValueComparerGenerator.Attributes\MintPlayer.ValueComparerGenerator.Attributes.csproj" />
	</ItemGroup>

	<Import Project="..\..\eng\sourcegenerator.targets" />

	<ItemGroup>
	  <PackageReference Update="Microsoft.CodeAnalysis" Version="5.3.0" />
	  <PackageReference Update="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
	  <PackageReference Update="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
	</ItemGroup>
	<!-- The package README is the canonical docs for this generator; ship it to NuGet. -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>