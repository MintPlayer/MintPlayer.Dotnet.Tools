<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPathsMintPlayerSourceGenerators</GetTargetPathDependsOn>
	</PropertyGroup>

	<Target Name="GetDependencyTargetPathsMintPlayerSourceGenerators">
		<ItemGroup>
			<TargetPathWithTargetPlatformMoniker Include="$(MSBuildThisFileDirectory)\..\MintPlayer.SourceGenerators.Attributes\bin\$(Configuration)\netstandard2.0\MintPlayer.SourceGenerators.Attributes.dll" IncludeRuntimeDependency="true" />
			<TargetPathWithTargetPlatformMoniker Include="$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)\lib\netstandard2.0\Microsoft.Extensions.DependencyInjection.Abstractions.dll" IncludeRuntimeDependency="false" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<Version>10.21.1</Version>
		<Authors>Pieterjan De Clippel</Authors>
		<Company>MintPlayer</Company>
		<Description>This package contains several source generators</Description>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools/SourceGenerators/MintPlayer.SourceGenerators</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageId>MintPlayer.SourceGenerators</PackageId>
		<PackageTags>SourceGenerators</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!--<DebugType>embedded</DebugType>-->
		<IncludeSymbols>false</IncludeSymbols>
		<!--<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
		<!--<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>-->
	</PropertyGroup>

	<!--
	Microsoft.Extensions.DependencyInjection.Abstractions, which ServiceRegistrationsGenerator
	needs at ANALYSIS time — Roslyn loads it from the analyzer folder rather than the consumer
	referencing it.

	Only this concern lives here. The generator's own attributes come from
	eng/sourcegenerator.targets and the [AutoValueComparer] assembly from
	eng/valuecomparergenerator.targets, each imported by the projects that need them.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAnalysisTimeDependencies</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="AddAnalysisTimeDependencies">
		<ItemGroup>
			<_DiAbstractionsAssets Include="$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)\lib\netstandard2.0\*.dll" />
		</ItemGroup>

		<Error Condition="'@(_DiAbstractionsAssets)' == ''"
		       Text="Microsoft.Extensions.DependencyInjection.Abstractions was not found in the restored package folder. ServiceRegistrationsGenerator would ship unable to resolve ServiceLifetime." />

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_DiAbstractionsAssets)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

    <ItemGroup>
        <None Include="build\MintPlayer.SourceGenerators.props" Pack="true" PackagePath="build\MintPlayer.SourceGenerators.props" />
        <None Include="build\MintPlayer.SourceGenerators.targets" Pack="true" PackagePath="build\MintPlayer.SourceGenerators.targets" />
    </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.SourceGenerators.Attributes\MintPlayer.SourceGenerators.Attributes.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Needed at generator initialization to resolve ServiceLifetime/IServiceCollection -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" PrivateAssets="all" GeneratePathProperty="true" />
	</ItemGroup>

	<Import Project="..\..\eng\sourcegenerator.targets" />
	<Import Project="..\..\eng\newtonsoftjson.targets" />
	<Import Project="..\..\eng\valuecomparergenerator.targets" />
	<ItemGroup>
	  <PackageReference Update="Microsoft.CodeAnalysis" Version="5.3.0" />
	  <PackageReference Update="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
	  <PackageReference Update="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
	</ItemGroup>
	<!-- The package README is the canonical docs for this generator; ship it to NuGet. -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>