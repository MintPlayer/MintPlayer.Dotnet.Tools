<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<!--
	This file does the following:
		- Only runs when the package is installed as a PackageReference, not in this solution
		- Defines properties for building a source generator package
		- References the necessary Roslyn packages based on the selected Roslyn version
		- Puts the built DLL and its dependencies in the correct package path for Roslyn analyzers
	-->

	<PropertyGroup>
		<DevelopmentDependency>true</DevelopmentDependency>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<RoslynVersion></RoslynVersion>
	</PropertyGroup>

	<!--
	One Roslyn version. This was a <Choose> on $(RoslynVersion) whose 'roslyn4.0' branch could never
	be taken — the property was declared empty and nothing set it — and whose two branches referenced
	identical package versions, differing only in ROSLYN_4_* constants that nothing tested.

	5.9.0 is the floor, the latest stable Roslyn on nuget.org at the time it was chosen. For reference:
	.NET 10.0.112 -> Roslyn 5.0.0, .NET 10.0.401 -> 5.9.0, .NET 11 rc.1 -> 5.11.0 — so this needs
	.NET SDK 10.0.4xx or later. An older host finds no analyzers/dotnet/roslyn5.9/cs folder it qualifies
	for and skips the generator, rather than loading an assembly it cannot resolve and failing with CS8032.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<ItemGroup>
		<!-- Put the assets for this project in the correct package path -->

		<!-- Roslyn 5.9 — see eng/sourcegenerator.targets for why this is the minimum -->
		<None Include="$(MSBuildProjectDirectory)\bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="true" />
		<None Include="$(PkgMintPlayer_SourceGenerators_Tools)\lib\netstandard2.0\*.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="true" />

		<!-- Attributes assembly, if exists -->
		<None Condition="'$(Configuration)' == 'Release' " Include="$(MSBuildProjectDirectory)..\$(MSBuildProjectName).Attributes\bin\$(Configuration)\netstandard2.0\*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="true" />
	</ItemGroup>

	<!-- Microsoft.Extensions.DependencyInjection.Abstractions (only when referenced in the package project) -->
	<ItemGroup Condition="'$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)' != ''">
		<!-- Roslyn 5.9 — see eng/sourcegenerator.targets for why this is the minimum -->
		<None Include="$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)\lib\netstandard2.0\*.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.9/cs" Visible="true" />
	</ItemGroup>
</Project>
