<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>11.0.0-rc.1</Version>
		<Authors>Pieterjan De Clippel</Authors>
		<Company>MintPlayer</Company>
		<Description>This package contains useful tools for building source generators</Description>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools/SourceGenerators/MintPlayer.SourceGenerators.Tools</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageId>MintPlayer.SourceGenerators.Tools</PackageId>
		<PackageTags>SourceGenerators</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>

	<ItemGroup>
		<!-- Allow users to easily reference these targets -->
		<None Include="..\eng\filenesting.targets" Link="Targets\filenesting.targets" Pack="true" PackagePath="eng/%(Filename)%(Extension)" />
		
		<!--
		These targets apply when the package is installed
		We don't want these targets to load when a source-generator that uses this package is installed in a simple console application
		Therefore we pick build instead of buildTransitive
		-->
		<None Include="Targets\sourcegenerator_tools.props" Pack="true" PackagePath="build/$(PackageId).props" />
		<None Include="Targets\sourcegenerator_tools.targets" Pack="true" PackagePath="build/$(PackageId).targets" />
	</ItemGroup>

	<!--
	Built once per Roslyn flavour, same as the generators that carry it. See eng/roslyn.props.
	The generator and the Tools.dll sitting next to it in analyzers/dotnet/roslyn<N.N>/cs must be
	compiled against the same Roslyn, or the generator resolves its base class against the wrong
	Microsoft.CodeAnalysis and fails inside the consumer's compiler.
	-->
	<Import Project="../eng/roslyn.props" />

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisVersion)" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="$(MicrosoftCodeAnalysisAnalyzersVersion)" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<Import Project="../eng/filenesting.targets" />
	<!-- The package README is the canonical docs for this library; ship it to NuGet. -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- TypeExtensions is internal; the tests exercise it directly. -->
	<ItemGroup>
		<InternalsVisibleTo Include="MintPlayer.SourceGenerators.Tools.Tests" />
	</ItemGroup>

</Project>