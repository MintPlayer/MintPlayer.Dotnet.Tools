<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>14</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<IsAotCompatible>true</IsAotCompatible>

		<IsPackable>true</IsPackable>
		<Version>1.0.0</Version>
		<Authors>Pieterjan De Clippel</Authors>
		<Company>MintPlayer</Company>
		<Description>Fluent assertion library for .NET. Free forever (Apache-2.0), AOT/trimming-safe, with source-generated object-graph equivalency and first-class analyzers.</Description>
		<PackageProjectUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools/Assertions/MintPlayer.Assertions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MintPlayer/MintPlayer.Dotnet.Tools</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageId>MintPlayer.Assertions</PackageId>
		<PackageTags>Assertions,Testing,Fluent,FluentAssertions,xUnit,NUnit,MSTest,TUnit,AOT</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<!-- Include XML markups in the nupkg -->
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- The source generator and analyzers ship inside this package so a single
	     PackageReference gives consumers the full experience. -->
	<ItemGroup>
		<ProjectReference Include="..\MintPlayer.Assertions.SourceGenerator\MintPlayer.Assertions.SourceGenerator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<!--
	The analyzer payload is collected in a TARGET, not a static ItemGroup. An Include pointing at
	a sibling project's bin folder is resolved at evaluation time, before that project has been
	built, so on a clean tree it matched nothing and this package shipped with no analyzers at
	all — silently. A Configuration == 'Release' condition on the Tools DLL made it fail in Debug
	even after a build. Both are fixed; PackagingTests pins the layout and Debug/Release parity.
	-->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAssertionsAnalyzers</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="AddAssertionsAnalyzers">
		<ItemGroup>
			<_AssertionsAnalyzer Include="..\MintPlayer.Assertions.SourceGenerator\bin\$(Configuration)\netstandard2.0\MintPlayer.Assertions.SourceGenerator.dll" />
			<_AssertionsAnalyzerTools Include="..\..\SourceGenerators\MintPlayer.SourceGenerators.Tools\bin\$(Configuration)\netstandard2.0\MintPlayer.SourceGenerators.Tools.dll" />
		</ItemGroup>

		<Error Condition="!Exists('%(_AssertionsAnalyzer.FullPath)')"
		       Text="MintPlayer.Assertions.SourceGenerator was not found in bin\$(Configuration)\netstandard2.0. Packing would ship the assertion library with no analyzers, and no error to tell anyone." />
		<Error Condition="!Exists('%(_AssertionsAnalyzerTools.FullPath)')"
		       Text="MintPlayer.SourceGenerators.Tools was not found in bin\$(Configuration)\netstandard2.0. The analyzers would ship unable to resolve their base class." />

		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_AssertionsAnalyzer)" PackagePath="analyzers/dotnet/cs" />
			<TfmSpecificPackageFile Include="@(_AssertionsAnalyzerTools)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

	<!-- StringDifference builds the "they differ at index N" hint and is internal; the
	     tests exercise it directly rather than only through a failure message. -->
	<ItemGroup>
		<InternalsVisibleTo Include="MintPlayer.Assertions.Tests" />
	</ItemGroup>

</Project>
